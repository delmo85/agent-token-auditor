# =====================================================================
# Local AI & FastMCP Dispatcher Environment Variables
# =====================================================================

# Local OpenAI-Compatible Server (LM Studio, Ollama, vLLM, LocalAI)
LOCAL_AI_BASE_URL=http://localhost:1234/v1
LOCAL_AI_MODEL=qwen/qwen2.5-coder-7b-instruct
LOCAL_AI_TIMEOUT=120.0

# OpenRouter Configuration (Optional - for cloud fallback & smart routing)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FREE_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_SMART_MODEL=deepseek/deepseek-r1

# Antigravity Brain Directory Override (Optional - detected automatically if omitted)
# ANTIGRAVITY_DATA_DIR=C:\Users\username\.gemini\antigravity\brain

# Currency Conversion (USD to local currency for savings reports)
CURRENCY_RATE_USD=5.75
